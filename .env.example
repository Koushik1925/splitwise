# Root reference for all environment variables used across the monorepo.
# Copy the relevant subset into apps/api/.env and apps/web/.env.local for
# local development. Never commit real secrets.

# --- Backend (apps/api) ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

MONGODB_URI=
REDIS_URL=

JWT_SECRET=
# Lifetime of the access token and its server-side session (default: 7 days).
AUTH_TOKEN_TTL_SECONDS=604800

EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=

UPI_PROVIDER_KEY=
UPI_PROVIDER_SECRET=

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
